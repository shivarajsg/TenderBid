# Application Configuration
APP_NAME="Tender Intelligence Platform API"
APP_ENV="development" # development | staging | production
DEBUG=true

# Database Configuration (PostgreSQL with asyncpg)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+asyncpg://tender_app:REPLACE_WITH_DEV_PASSWORD@127.0.0.1:5433/tender_platform"

# Security & JWT Configuration
# Generate a high-entropy secret in production (e.g., openssl rand -hex 32)
JWT_SECRET_KEY="REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS / Frontend Allowed Origins (Comma-separated list or JSON array)
FRONTEND_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Protected Local File Storage Directory
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25

# Document Intelligence & OCR Fallback
# On Windows, set full path if tesseract is not in system PATH:
# TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
TESSERACT_CMD=""

# ChromaDB Persistent Vector Storage
CHROMA_PERSIST_DIRECTORY="./data/chroma"
CHROMA_COLLECTION_NAME="tender_documents"
CHROMA_COMPANY_COLLECTION_NAME="company_documents"
EMBEDDING_PROVIDER="default"
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Phase 4 - Google Gemini AI API Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="REPLACE_WITH_YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3

# Phase 11 - Automated Government Tender Ingestion
INGESTION_ENABLED=true
INGESTION_INTERVAL_SECONDS=3600
INGESTION_BATCH_SIZE=50
GEM_API_KEY=""
CPPP_API_KEY=""

# Phase 11 - TenderKart Client API Ingestion (Third-Party Provider)
TENDERKART_ENABLED=true
TENDERKART_API_KEY=""
TENDERKART_BASE_URL="https://tenderkart.in/api/v1/client"
TENDERKART_DEFAULT_FILTER_ID=""
TENDERKART_FULL_SEARCH_ENABLED=false
TENDERKART_DOWNLOAD_DOCS=false

# Phase 11 - Apify Actor Ingestion (foxlabs/india-government-tenders)
APIFY_ENABLED=true
APIFY_API_TOKEN=""
APIFY_ACTOR_ID="foxlabs~india-government-tenders"
APIFY_MAX_RESULTS=5
APIFY_MODE="list"
APIFY_DATE_PRESET="last_7_days"

# Document Retrieval & SSRF Protection
MAX_DOCUMENT_DOWNLOAD_BYTES=52428800
ALLOWED_DOCUMENT_DOMAINS="gov.in,nic.in,tenderkart.in,apify.com"
