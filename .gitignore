# ==========================================
# Root .gitignore - Tender Intelligence Platform
# ==========================================

# Environment variables & secrets (Never commit secrets)
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example
*.pem
*.key
*.cert

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
env/
venv/
ENV/
build/
dist/
*.egg-info/
.eggs/

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database, ChromaDB & Upload Storage
uploads/
backend/uploads/
downloads/
backend/downloads/
data/
backend/data/
*.sqlite
*.sqlite3
*.db

# Testing & Coverage
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/
coverage/

# IDE & OS Artifacts
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
